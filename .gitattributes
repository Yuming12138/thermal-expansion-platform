* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf

# CSV data exports are served verbatim (UTF-8 BOM + CRLF); never normalize.
*.csv -text

# Version the compressed dataset snapshot with Git LFS.
datasets/releases/**/*.json.gz filter=lfs diff=lfs merge=lfs -text
